          "id": "24005ed0-3cd6-4fdb-8f26-ea5667a16466",
          "name": "Get User-Entered Events",
          "request": {
            "name": "Get User-Entered Events",
            "description": {
              "content": "Retrieve user-entered event records (carbohydrates, insulin, exercise, and health events) between `startDate` and `endDate`.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v3",
                "users",
                "self",
                "events"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "startDate",
                  "value": "<dateTime>",
                  "description": "(Required) ISO 8601 timestamp for the start of the query window (UTC, no offset)."
                },
                {
                  "disabled": false,
                  "key": "endDate",
                  "value": "<dateTime>",
                  "description": "(Required) ISO 8601 timestamp for the end of the query window (UTC, no offset). Must be no more than 30 days after `startDate`."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
