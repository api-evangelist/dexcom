      "name": "Alerts",
      "description": {
        "content": "Alert events generated by the user's CGM display device.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "2344940b-8584-4faa-91e5-dfe99460e483",
          "name": "Get Alert Events",
          "request": {
            "name": "Get Alert Events",
            "description": {
              "content": "Retrieve alert events (high, low, urgent low, rise, fall, no readings, and out-of-range alerts) generated by the user's CGM display device between `startDate` and `endDate`.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v3",
                "users",
                "self",
                "alerts"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "startDate",
                  "value": "<dateTime>",
                  "description": "(Required) ISO 8601 timestamp for the start of the query window (UTC, no offset)."
                },
                {
                  "disabled": false,
                  "key": "endDate",
                  "value": "<dateTime>",
                  "description": "(Required) ISO 8601 timestamp for the end of the query window (UTC, no offset). Must be no more than 30 days after `startDate`."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
            {
              "id": "d27fef4e-af2b-4a28-be30-ad6ccc2ed7f0",
              "name": "Successful alerts retrieval.",
              "originalRequest": {
