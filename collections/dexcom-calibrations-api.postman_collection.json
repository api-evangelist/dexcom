          "name": "Get Calibration Entries",
          "request": {
            "name": "Get Calibration Entries",
            "description": {
              "content": "Retrieve calibration entries (fingerstick blood glucose meter values entered by the user) between `startDate` and `endDate`.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v3",
                "users",
                "self",
                "calibrations"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "startDate",
                  "value": "<dateTime>",
                  "description": "(Required) ISO 8601 timestamp for the start of the query window (UTC, no offset)."
                },
                {
                  "disabled": false,
                  "key": "endDate",
                  "value": "<dateTime>",
                  "description": "(Required) ISO 8601 timestamp for the end of the query window (UTC, no offset). Must be no more than 30 days after `startDate`."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
