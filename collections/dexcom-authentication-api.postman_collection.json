      "item": [
        {
          "id": "f80ab794-aa36-48d8-b9ce-2d63e352381a",
          "name": "Initiate OAuth 2.0 Authorization",
          "request": {
            "name": "Initiate OAuth 2.0 Authorization",
            "description": {
              "content": "Redirect the end user to the Dexcom hosted login page to obtain an authorization code. The user authenticates with Dexcom credentials and consents to share CGM data with the requesting application.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v2",
                "oauth2",
                "login"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "client_id",
                  "value": "<string>",
                  "description": "(Required) The application's registered client identifier."
                },
                {
                  "disabled": false,
                  "key": "redirect_uri",
                  "value": "<uri>",
                  "description": "(Required) Registered redirect URI to which the authorization code is appended."
                },
                {
                  "disabled": false,
                  "key": "response_type",
                  "value": "<string>",
                  "description": "(Required) Must be set to `code` for authorization code flow."
                },
                {
                  "disabled": false,
                  "key": "scope",
                  "value": "<string>",
                  "description": "(Required) Must be `offline_access` (the only currently accepted value)."
                },
                {
                  "disabled": false,
                  "key": "state",
                  "value": "<string>",
                  "description": "Opaque value used to maintain state between request and callback (CSRF protection)."
                }
              ],
              "variable": []
            },
            "method": "GET",
            "auth": null
          },
          "response": [
            {
              "id": "1ddc5277-1e64-4945-a503-54a4f34964e1",
