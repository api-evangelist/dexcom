        {
          "id": "571aaccf-f46f-4677-a987-d681b9898ffe",
          "name": "Exchange Authorization Code for Tokens",
          "request": {
            "name": "Exchange Authorization Code for Tokens",
            "description": {
              "content": "Exchange a single-use authorization code for an access token and refresh token, or refresh an existing access token using a refresh token. Tokens must be stored on the partner's server.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v2",
                "oauth2",
                "token"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "disabled": false,
                  "key": "client_id",
                  "value": "<string>",
                  "description": "(Required) Application's registered client identifier."
                },
                {
                  "disabled": false,
                  "key": "client_secret",
                  "value": "<string>",
                  "description": "(Required) Application's client secret."
                },
                {
                  "disabled": false,
                  "key": "grant_type",
                  "value": "<string>",
                  "description": "(Required) "
                },
                {
                  "disabled": false,
                  "key": "code",
                  "value": "<string>",
                  "description": "Single-use authorization code (required when `grant_type=authorization_code`)."
                },
                {
                  "disabled": false,
                  "key": "refresh_token",
                  "value": "<string>",
                  "description": "Refresh token (required when `grant_type=refresh_token`)."
                },
                {
                  "disabled": false,
                  "key": "redirect_uri",
                  "value": "<uri>",
                  "description": "Registered redirect URI (required for `authorization_code`)."
                }
              ]
            }
          },
          "response": [
            {
              "id": "1f9089f8-6aa4-4fd4-9b69-b2d46d4a923b",
              "name": "Access token and refresh token returned.",
              "originalRequest": {
                "url": {
                  "path": [
                    "v2",
                    "oauth2",
                    "token"
