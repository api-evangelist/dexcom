                        "content": "(Required) Application's registered client identifier.",
                        "type": "text/plain"
                      },
                      "key": "client_id",
                      "value": "<string>"
                    },
                    {
                      "disabled": false,
                      "description": {
                        "content": "(Required) Application's client secret.",
                        "type": "text/plain"
                      },
                      "key": "client_secret",
                      "value": "<string>"
                    },
                    {
                      "disabled": false,
                      "description": {
                        "content": "(Required) ",
                        "type": "text/plain"
                      },
                      "key": "grant_type",
                      "value": "<string>"
                    },
                    {
                      "disabled": false,
                      "description": {
                        "content": "Single-use authorization code (required when `grant_type=authorization_code`).",
                        "type": "text/plain"
                      },
                      "key": "code",
                      "value": "<string>"
                    },
                    {
