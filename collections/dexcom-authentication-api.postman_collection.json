                      "key": "redirect_uri",
                      "value": "<uri>"
                    }
                  ]
                }
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"access_token\": \"{your_access_token}\",\n  \"expires_in\": 7200,\n  \"token_type\": \"Bearer\",\n  \"refresh_token\": \"{your_refresh_token}\"\n}",
              "cookie": [],
              "_postman_previewlanguage": "json"
            }
