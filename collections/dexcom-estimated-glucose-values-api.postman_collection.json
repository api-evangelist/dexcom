      "name": "Estimated Glucose Values",
      "description": {
        "content": "Time-series CGM glucose readings for the authorized user.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "914dd0c5-088f-4806-ac98-17006a295675",
          "name": "Get Estimated Glucose Values",
          "request": {
            "name": "Get Estimated Glucose Values",
            "description": {
              "content": "Retrieve estimated glucose values (EGVs) for the authorized user between `startDate` and `endDate`. The maximum window is 30 days and timestamps are interpreted against the device `systemTime` field.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v3",
                "users",
                "self",
                "egvs"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "startDate",
                  "value": "<dateTime>",
                  "description": "(Required) ISO 8601 timestamp for the start of the query window (UTC, no offset)."
                },
                {
                  "disabled": false,
                  "key": "endDate",
                  "value": "<dateTime>",
                  "description": "(Required) ISO 8601 timestamp for the end of the query window (UTC, no offset). Must be no more than 30 days after `startDate`."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
            {
