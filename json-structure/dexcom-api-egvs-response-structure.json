{
  "$schema": "https://json-structure.org/meta/core/v0/#",
  "$id": "https://raw.githubusercontent.com/api-evangelist/dexcom/refs/heads/main/json-structure/dexcom-api-egvs-response-structure.json",
  "name": "EgvsResponse",
  "description": "EgvsResponse schema from Dexcom Developer API",
  "type": "object",
  "properties": {
    "recordType": {
      "type": "string",
      "example": "egv"
    },
    "recordVersion": {
      "type": "string",
      "example": "3.0"
    },
    "userId": {
      "type": "string"
    },
    "records": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/EGVRecord"
      }
    }
  },
  "definitions": {
    "EGVRecord": {
      "name": "EGVRecord",
      "type": "object",
      "properties": {
        "recordId": {
          "type": "string"
        },
        "systemTime": {
          "$ref": "#/definitions/DateTime"
        },
        "displayTime": {
          "$ref": "#/definitions/DateTime"
        },
        "transmitterId": {
          "type": "string",
          "nullable": true
        },
        "transmitterTicks": {
          "type": "int64"
        },
        "value": {
          "type": "int32",
          "description": "Estimated glucose value, in `unit`."
        },
        "status": {
          "$ref": "#/definitions/EgvStatus"
        },
        "trend": {
          "$ref": "#/definitions/TrendType"
        },
        "trendRate": {
          "type": "double",
          "nullable": true
        },
        "unit": {
          "$ref": "#/definitions/GlucoseUnit"
        },
        "rateUnit": {
          "$ref": "#/definitions/RateUnit"
        },
        "displayDevice": {
          "type": "string",
          "description": "One of `iOS`, `android`, or `receiver`."
        },
        "transmitterGeneration": {
          "$ref": "#/definitions/TransmitterGeneration"
        }
      },
      "description": "A single estimated glucose value record."
    },
    "DateTime": {
      "name": "DateTime",
      "type": "datetime",
      "description": "ISO 8601 timestamp."
    },
    "TransmitterGeneration": {
      "name": "TransmitterGeneration",
      "type": "string",
      "enum": [
        "unknown",
        "g4",
        "g5",
        "g6",
        "g6+",
        "dexcomPro",
        "g7"
      ]
    },
    "TrendType": {
      "name": "TrendType",
      "type": "string",
      "enum": [
        "none",
        "unknown",
        "doubleUp",
        "singleUp",
        "fortyFiveUp",
        "flat",
        "fortyFiveDown",
        "singleDown",
        "doubleDown",
        "notComputable",
        "rateOutOfRange"
      ]
    },
    "RateUnit": {
      "name": "RateUnit",
      "type": "string",
      "enum": [
        "unknown",
        "mg/dL/min",
        "mmol/L/min"
      ]
    },
    "GlucoseUnit": {
      "name": "GlucoseUnit",
      "type": "string",
      "enum": [
        "unknown",
        "mg/dL",
        "mmol/L"
      ]
    },
    "EgvStatus": {
      "name": "EgvStatus",
      "type": "string",
      "enum": [
        "unknown",
        "high",
        "low",
        "ok"
      ]
    }
  }
}
