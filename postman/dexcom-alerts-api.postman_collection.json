                  "name": "alerts",
                  "item": [
                    {
                      "name": "Get Alert Events",
                      "id": "826ae6ef-326b-4232-ad92-6d6980ca862b",
                      "protocolProfileBehavior": {
                        "disableBodyPruning": true
                      },
                      "request": {
                        "method": "GET",
                        "header": [
                          {
                            "key": "Accept",
                            "value": "application/json"
                          }
                        ],
                        "url": {
                          "raw": "{{baseUrl}}/v3/users/self/alerts?startDate=<dateTime>&endDate=<dateTime>",
                          "host": [
                            "{{baseUrl}}"
                          ],
                          "path": [
                            "v3",
                            "users",
                            "self",
                            "alerts"
                          ],
                          "query": [
                            {
                              "description": "(Required) ISO 8601 timestamp for the start of the query window (UTC, no offset).",
                              "key": "startDate",
                              "value": "<dateTime>"
                            },
                            {
                              "description": "(Required) ISO 8601 timestamp for the end of the query window (UTC, no offset). Must be no more than 30 days after `startDate`.",
                              "key": "endDate",
                              "value": "<dateTime>"
                            }
                          ]
                        },
                        "description": "Retrieve alert events (high, low, urgent low, rise, fall, no readings, and out-of-range alerts) generated by the user's CGM display device between `startDate` and `endDate`."
                      },
                      "response": [
                        {
                          "id": "fab3a086-86b4-423b-acd3-13ded7fad67e",
                          "name": "Successful alerts retrieval.",
