                              "value": "<dateTime>"
                            },
                            {
                              "description": "(Required) ISO 8601 timestamp for the end of the query window (UTC, no offset). Must be no more than 30 days after `startDate`.",
                              "key": "endDate",
                              "value": "<dateTime>"
                            }
                          ]
                        },
                        "description": "Retrieve user-entered event records (carbohydrates, insulin, exercise, and health events) between `startDate` and `endDate`."
