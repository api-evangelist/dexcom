                  "protocolProfileBehavior": {
                    "disableBodyPruning": true
                  },
                  "request": {
                    "method": "GET",
                    "header": [],
                    "url": {
                      "raw": "{{baseUrl}}/v2/oauth2/login?client_id=<string>&redirect_uri=<uri>&response_type=code&scope=offline_access&state=<string>",
                      "host": [
                        "{{baseUrl}}"
                      ],
                      "path": [
                        "v2",
                        "oauth2",
                        "login"
                      ],
                      "query": [
                        {
                          "description": "(Required) The application's registered client identifier.",
                          "key": "client_id",
                          "value": "<string>"
                        },
                        {
                          "description": "(Required) Registered redirect URI to which the authorization code is appended.",
                          "key": "redirect_uri",
                          "value": "<uri>"
                        },
                        {
                          "description": "(Required) Must be set to `code` for authorization code flow.",
                          "key": "response_type",
                          "value": "code"
                        },
                        {
                          "description": "(Required) Must be `offline_access` (the only currently accepted value).",
                          "key": "scope",
                          "value": "offline_access"
                        },
                        {
                          "description": "Opaque value used to maintain state between request and callback (CSRF protection).",
                          "key": "state",
                          "value": "<string>"
                        }
                      ]
                    },
                    "description": "Redirect the end user to the Dexcom hosted login page to obtain an authorization code. The user authenticates with Dexcom credentials and consents to share CGM data with the requesting application."
